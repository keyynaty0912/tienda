# Copiar a .env.local. No subir secretos a Git.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# demo separa todas las colecciones de Firestore con prefijo demo_.
CATALOG_MODE=demo
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Alternativa preferida en un entorno de Google: Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=ruta-absoluta-fuera-del-repositorio.json
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Solo emuladores locales; nunca configurar estas variables en producción.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
CHECKOUT_ENABLED=false
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# No activar sin aprobación y pruebas de producción.
LIVE_PAYMENTS_APPROVED=false
# Claves aleatorias de al menos 32 caracteres, diferentes entre ambientes.
ORDER_TOKEN_SECRET=
CRON_SECRET=
# Opcional: dirección IP solo de un proxy verificado; vacío limita por sesión/global.
TRUSTED_IP_HEADER=
# Cola de correos lista para conectar a un proveedor; desactivada por defecto.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
