{
  "name": "key-naty",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "node node_modules/next/dist/bin/next build",
    "postinstall": "node scripts/patch-jwks.cjs",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "seed:demo": "node node_modules/tsx/dist/cli.mjs --env-file=.env.local scripts/seed.ts",
    "admin:grant": "node node_modules/tsx/dist/cli.mjs --env-file=.env.local scripts/grant-admin.ts"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
